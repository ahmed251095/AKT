<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="action_report_tender_cover_letter" model="ir.actions.report">
        <field name="name">Tender Cover Letter</field>
        <field name="model">construction.tender</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">aos_construction_ext.report_tender_cover_letter</field>
        <field name="report_file">aos_construction_ext.report_tender_cover_letter</field>
        <field name="binding_model_id" ref="aos_construction_management.model_construction_tender"/>
        <field name="binding_type">report</field>
        <field name="print_report_name">'Cover Letter - %s' % (object.ref or object.name)</field>
    </record>

    <record id="action_report_project_profit_statement" model="ir.actions.report">
        <field name="name">Profit Statement</field>
        <field name="model">construction.project</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">aos_construction_ext.report_project_profit_statement</field>
        <field name="report_file">aos_construction_ext.report_project_profit_statement</field>
        <field name="binding_model_id" ref="aos_construction_management.model_construction_project"/>
        <field name="binding_type">report</field>
        <field name="print_report_name">'Profit Statement - %s' % (object.ref or object.name)</field>
    </record>

</odoo>

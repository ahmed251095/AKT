<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_construction_config_settings" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.construction.ext</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="base.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//form" position="inside">
                <app data-string="Construction" string="Construction" name="aos_construction_ext"
                     groups="aos_construction_management.group_construction_manager">
                    <block title="Pricing Build-up"
                           help="Default ratios applied to every new tender and BOQ item. The rate is built as (dry cost + operating cost) x (1 + profit + contingency + administration) x (1 + general expenses).">
                        <setting string="Profit" help="Net profit added on top of the item cost.">
                            <field name="construction_profit_percent"/>
                        </setting>
                        <setting string="Contingency" help="Allowance for unforeseen site conditions and price variations.">
                            <field name="construction_contingency_percent"/>
                        </setting>
                        <setting string="Administration" help="Share of head office administration carried by the item.">
                            <field name="construction_admin_percent"/>
                        </setting>
                        <setting string="General Expenses" help="Applied on the marked-up price, the last step of the build-up.">
                            <field name="construction_expense_percent"/>
                        </setting>
                    </block>
                    <block title="Tenders">
                        <setting string="Reminder Lead Time" help="Days before a tender date the responsible users are reminded.">
                            <field name="construction_reminder_days"/>
                        </setting>
                        <setting string="Bid Bond" help="Default bid bond percentage of the announced value.">
                            <field name="construction_bid_bond_percent"/>
                        </setting>
                        <setting string="Performance Bond" help="Default performance bond percentage of the contract value.">
                            <field name="construction_performance_bond_percent"/>
                        </setting>
                    </block>
                </app>
            </xpath>
        </field>
    </record>

    <record id="action_construction_ext_config_settings" model="ir.actions.act_window">
        <field name="name">Settings</field>
        <field name="res_model">res.config.settings</field>
        <field name="view_mode">form</field>
        <field name="target">inline</field>
        <field name="context">{'module': 'aos_construction_ext'}</field>
    </record>

</odoo>

<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <record id="view_construction_ra_billing_form_ext" model="ir.ui.view">
    <field name="name">construction.ra.billing.form.ext</field>
    <field name="model">construction.ra.billing</field>
    <field name="inherit_id" ref="aos_construction_management.view_construction_ra_billing_form"/>
    <field name="arch" type="xml">
      <xpath expr="//div[hasclass('oe_title')]/field[@name='ref']" position="after">
        <div class="text-muted">
          <label for="ra_number" class="oe_inline"/>
          <field name="ra_number" readonly="1" class="oe_inline"/>
        </div>
      </xpath>
      <xpath expr="//field[@name='advance_recovery']" position="before">
        <field name="advance_outstanding" readonly="1"
               invisible="advance_outstanding == 0"/>
      </xpath>

      <!-- From approval on the certificate is what is owed. The models refuse
           the write either way; this is so the form says so first. -->
      <xpath expr="//field[@name='name']" position="attributes">
        <attribute name="readonly">state in ('approved', 'invoiced', 'paid')</attribute>
      </xpath>
      <xpath expr="//field[@name='billing_type']" position="attributes">
        <attribute name="readonly">state in ('approved', 'invoiced', 'paid')</attribute>
      </xpath>
      <xpath expr="//field[@name='project_id']" position="attributes">
        <attribute name="readonly">state in ('approved', 'invoiced', 'paid')</attribute>
      </xpath>
      <xpath expr="//field[@name='partner_id']" position="attributes">
        <attribute name="readonly">state in ('approved', 'invoiced', 'paid')</attribute>
      </xpath>
      <xpath expr="//field[@name='subcontract_id']" position="attributes">
        <attribute name="readonly">state in ('approved', 'invoiced', 'paid')</attribute>
      </xpath>
      <xpath expr="//field[@name='purchase_order_id']" position="attributes">
        <attribute name="readonly">state in ('approved', 'invoiced', 'paid')</attribute>
      </xpath>
      <xpath expr="//field[@name='billing_date']" position="attributes">
        <attribute name="readonly">state in ('approved', 'invoiced', 'paid')</attribute>
      </xpath>
      <xpath expr="//field[@name='billing_period_start']" position="attributes">
        <attribute name="readonly">state in ('approved', 'invoiced', 'paid')</attribute>
      </xpath>
      <xpath expr="//field[@name='billing_period_end']" position="attributes">
        <attribute name="readonly">state in ('approved', 'invoiced', 'paid')</attribute>
      </xpath>
      <xpath expr="//field[@name='retention_percent']" position="attributes">
        <attribute name="readonly">state in ('approved', 'invoiced', 'paid')</attribute>
      </xpath>
      <xpath expr="//field[@name='advance_recovery']" position="attributes">
        <attribute name="readonly">state in ('approved', 'invoiced', 'paid')</attribute>
      </xpath>
      <xpath expr="//field[@name='other_deductions']" position="attributes">
        <attribute name="readonly">state in ('approved', 'invoiced', 'paid')</attribute>
      </xpath>
      <xpath expr="//field[@name='tax_ids']" position="attributes">
        <attribute name="readonly">state in ('approved', 'invoiced', 'paid')</attribute>
      </xpath>
      <xpath expr="//field[@name='line_ids']" position="attributes">
        <attribute name="readonly">state in ('approved', 'invoiced', 'paid')</attribute>
      </xpath>
      <xpath expr="//field[@name='notes']" position="attributes">
        <attribute name="readonly">state in ('approved', 'invoiced', 'paid')</attribute>
      </xpath>
    </field>
  </record>

  <record id="view_construction_ra_billing_list_ext" model="ir.ui.view">
    <field name="name">construction.ra.billing.list.ext</field>
    <field name="model">construction.ra.billing</field>
    <field name="inherit_id" ref="aos_construction_management.view_construction_ra_billing_list"/>
    <field name="arch" type="xml">
      <xpath expr="//field[@name='name']" position="after">
        <field name="ra_number" string="No."/>
      </xpath>
      <xpath expr="//field[@name='retention_amount']" position="after">
        <field name="advance_recovery" optional="show"/>
      </xpath>
    </field>
  </record>
</odoo>

<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!--
        The planned start / planned end dates on a WBS phase are never read by
        any computation in the base module - they are plain informative dates
        that duplicate the project schedule, so they are dropped.

        The budget figures go the same way: budget revenue and budget cost only
        restate the bill of quantities that is already listed on the phase,
        planned cost is a hand-typed number nothing reads, and committed cost
        belongs on the purchase side. What is left is what was really spent,
        what was certified, and the margin - and that whole block is management's,
        so it is held behind the margin group.

        The phase code is a free-text field nothing reads - no sequence feeds it,
        no report groups by it, nothing points at it - so the phase is identified
        by its name alone and the code is dropped everywhere it shows.
    -->

    <record id="view_construction_wbs_form_ext" model="ir.ui.view">
        <field name="name">construction.wbs.form.ext</field>
        <field name="model">construction.wbs</field>
        <field name="inherit_id" ref="aos_construction_management.view_construction_wbs_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='code'][following-sibling::field[@name='project_id']]" position="replace"/>
            <xpath expr="//field[@name='planned_start'][following-sibling::field[@name='actual_start']]" position="replace"/>
            <xpath expr="//field[@name='planned_end'][following-sibling::field[@name='actual_end']]" position="replace"/>
            <!-- The whole left column of the Cost block is budget figures. -->
            <xpath expr="//field[@name='budget_revenue']/parent::group" position="replace">
                <field name="currency_id" invisible="1"/>
            </xpath>
            <!-- The margin is unreadable without the cost it is taken from. -->
            <xpath expr="//field[@name='forecast_margin']" position="before">
                <field name="forecast_cost" readonly="1"/>
            </xpath>
            <xpath expr="//field[@name='forecast_margin']/ancestor::group[2]" position="attributes">
                <attribute name="groups">aos_construction_ext.group_construction_margin</attribute>
            </xpath>
            <!-- The phase tree is optional: off, a phase is just a phase. -->
            <xpath expr="//field[@name='parent_id']" position="attributes">
                <attribute name="groups">aos_construction_ext.group_construction_wbs_hierarchy</attribute>
            </xpath>
            <xpath expr="//field[@name='child_ids']/ancestor::page[1]" position="attributes">
                <attribute name="groups">aos_construction_ext.group_construction_wbs_hierarchy</attribute>
            </xpath>
            <xpath expr="//field[@name='child_ids']/list/field[@name='code']" position="replace"/>
            <!-- Same dates again, this time the work orders' own. -->
            <xpath expr="//field[@name='work_order_ids']/list/field[@name='planned_start']" position="replace"/>
            <xpath expr="//field[@name='work_order_ids']/list/field[@name='planned_end']" position="replace"/>
        </field>
    </record>

    <record id="view_construction_wbs_list_ext" model="ir.ui.view">
        <field name="name">construction.wbs.list.ext</field>
        <field name="model">construction.wbs</field>
        <field name="inherit_id" ref="aos_construction_management.view_construction_wbs_list"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='code']" position="replace"/>
            <xpath expr="//field[@name='planned_start']" position="replace"/>
            <xpath expr="//field[@name='planned_end']" position="replace"/>
            <xpath expr="//field[@name='budget_revenue']" position="replace"/>
            <xpath expr="//field[@name='budget_cost']" position="replace"/>
            <xpath expr="//field[@name='planned_cost']" position="replace"/>
            <xpath expr="//field[@name='committed_cost']" position="replace"/>
            <xpath expr="//field[@name='parent_id']" position="attributes">
                <attribute name="groups">aos_construction_ext.group_construction_wbs_hierarchy</attribute>
            </xpath>
        </field>
    </record>

</odoo>

<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!--
        "Nothing but Construction from the outside" for the technical office.

        Every app below was reachable by any internal employee, because its
        root menu is gated on base.group_user - which the technical office,
        being an internal employee, has. A menu's groups are a relational
        field, so "everyone except this profile" cannot be expressed there.
        The marker is the same one the menus inside the app use:
        group_construction_user, carried by every other desk and by nobody in
        the technical office.

        base.group_user is swapped for it; the other groups already on each
        menu are kept verbatim, so the HR officer keeps Employees and the
        contact manager keeps Contacts.

        These are core menus. An upgrade of mail, hr or calendar resets them to
        their own definition, and this module has to be upgraded again after -
        worth knowing before blaming the group.
    -->

    <record id="mail.menu_root_discuss" model="ir.ui.menu">
        <field name="group_ids" eval="[(6, 0, [ref('aos_construction_management.group_construction_user')])]"/>
    </record>

    <record id="calendar.mail_menu_calendar" model="ir.ui.menu">
        <field name="group_ids" eval="[(6, 0, [ref('aos_construction_management.group_construction_user')])]"/>
    </record>

    <record id="appointment.main_menu_appointments" model="ir.ui.menu">
        <field name="group_ids" eval="[(6, 0, [ref('aos_construction_management.group_construction_user')])]"/>
    </record>

    <record id="contacts.menu_contacts" model="ir.ui.menu">
        <field name="group_ids" eval="[(6, 0, [
            ref('base.group_partner_manager'),
            ref('aos_construction_management.group_construction_user'),
        ])]"/>
    </record>

    <record id="spreadsheet_dashboard.spreadsheet_dashboard_menu_root" model="ir.ui.menu">
        <field name="group_ids" eval="[(6, 0, [ref('aos_construction_management.group_construction_user')])]"/>
    </record>

    <record id="hr.menu_hr_root" model="ir.ui.menu">
        <field name="group_ids" eval="[(6, 0, [
            ref('hr.group_hr_user'),
            ref('hr.group_hr_manager'),
            ref('aos_construction_management.group_construction_user'),
        ])]"/>
    </record>

    <!--
        Link Tracker is gated on base.group_no_one, "Technical Features" - which
        base.group_user implies on this database, so it reached every employee.
        Gated like the rest here rather than by touching that implication,
        which carries far more than this one menu.
    -->
    <record id="utm.menu_link_tracker_root" model="ir.ui.menu">
        <field name="group_ids" eval="[(6, 0, [ref('aos_construction_management.group_construction_user')])]"/>
    </record>

    <!--
        Apps and Technical Tests were open to every employee on this database -
        not the technical office's doing, and not Odoo's default either, which
        puts both behind Settings access. Anyone could reach the module list.
        Returned to the administrators.
    -->
    <record id="base.menu_management" model="ir.ui.menu">
        <field name="group_ids" eval="[(6, 0, [ref('base.group_system')])]"/>
    </record>

    <record id="base.menu_tests" model="ir.ui.menu">
        <field name="group_ids" eval="[(6, 0, [ref('base.group_system')])]"/>
    </record>

</odoo>

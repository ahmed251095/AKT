<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_construction_authority_type_list" model="ir.ui.view">
        <field name="name">construction.authority.type.list</field>
        <field name="model">construction.authority.type</field>
        <field name="arch" type="xml">
            <list string="Authority Types" editable="bottom">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="code"/>
                <field name="is_government"/>
                <field name="default_bid_bond_percent"/>
                <field name="active" column_invisible="1"/>
            </list>
        </field>
    </record>

    <record id="view_construction_authority_type_form" model="ir.ui.view">
        <field name="name">construction.authority.type.form</field>
        <field name="model">construction.authority.type</field>
        <field name="arch" type="xml">
            <form string="Authority Type">
                <sheet>
                    <widget name="web_ribbon" title="Archived" bg_color="text-bg-danger"
                            invisible="active"/>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="code"/>
                            <field name="sequence"/>
                            <field name="active"/>
                        </group>
                        <group>
                            <field name="is_government"/>
                            <field name="default_bid_bond_percent"/>
                        </group>
                    </group>
                    <group string="Notes">
                        <field name="note" nolabel="1"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_construction_authority_type" model="ir.actions.act_window">
        <field name="name">Authority Types</field>
        <field name="res_model">construction.authority.type</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Define the kinds of client you bid to</p>
            <p>Endowments, agricultural companies, ministries and private owners each ask for
               different paperwork and different bid bonds.</p>
        </field>
    </record>

    <record id="view_construction_document_type_list" model="ir.ui.view">
        <field name="name">construction.document.type.list</field>
        <field name="model">construction.document.type</field>
        <field name="arch" type="xml">
            <list string="Document Types" editable="bottom">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="code"/>
                <field name="file_type"/>
                <field name="scope"/>
                <field name="is_default_required"/>
                <field name="has_expiry"/>
                <field name="active" column_invisible="1"/>
            </list>
        </field>
    </record>

    <record id="view_construction_document_type_form" model="ir.ui.view">
        <field name="name">construction.document.type.form</field>
        <field name="model">construction.document.type</field>
        <field name="arch" type="xml">
            <form string="Document Type">
                <sheet>
                    <widget name="web_ribbon" title="Archived" bg_color="text-bg-danger"
                            invisible="active"/>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="code"/>
                            <field name="sequence"/>
                            <field name="active"/>
                        </group>
                        <group>
                            <field name="file_type"/>
                            <field name="scope"/>
                            <field name="is_default_required"/>
                            <field name="has_expiry"/>
                        </group>
                    </group>
                    <group string="Notes">
                        <field name="note" nolabel="1"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_construction_document_type" model="ir.actions.act_window">
        <field name="name">Document Types</field>
        <field name="res_model">construction.document.type</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">List the papers a bid file has to contain</p>
            <p>A bid cannot be submitted while one of these is still missing from the tender.</p>
        </field>
    </record>

</odoo>

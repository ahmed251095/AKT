<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_construction_document_list" model="ir.ui.view">
        <field name="name">construction.document.list</field>
        <field name="model">construction.document</field>
        <field name="arch" type="xml">
            <list string="Documents" editable="bottom"
                  decoration-danger="is_expired"
                  decoration-muted="not is_required and not is_submitted">
                <field name="sequence" widget="handle"/>
                <field name="document_type_id"/>
                <field name="file_type"/>
                <field name="reference" optional="show"/>
                <field name="issue_date" optional="hide"/>
                <field name="expiry_date" optional="show"/>
                <field name="is_expired" optional="hide"/>
                <field name="is_required"/>
                <field name="is_submitted" widget="boolean_toggle"/>
                <field name="submission_date" optional="hide"/>
                <field name="attachment_count" string="Files"/>
                <field name="tender_id" column_invisible="1"/>
                <field name="project_id" column_invisible="1"/>
            </list>
        </field>
    </record>

    <record id="view_construction_document_form" model="ir.ui.view">
        <field name="name">construction.document.form</field>
        <field name="model">construction.document</field>
        <field name="arch" type="xml">
            <form string="Document">
                <sheet>
                    <widget name="web_ribbon" title="Expired" bg_color="text-bg-danger"
                            invisible="not is_expired"/>
                    <group>
                        <group>
                            <field name="document_type_id"/>
                            <field name="file_type"/>
                            <field name="reference"/>
                            <field name="is_required"/>
                        </group>
                        <group>
                            <field name="tender_id" readonly="project_id"/>
                            <field name="project_id" readonly="tender_id"/>
                            <field name="issue_date"/>
                            <field name="expiry_date"/>
                            <field name="is_expired" invisible="not is_expired"/>
                        </group>
                    </group>
                    <group>
                        <group string="Submission">
                            <field name="is_submitted"/>
                            <field name="submission_date" invisible="not is_submitted"/>
                        </group>
                    </group>
                    <group string="Files">
                        <field name="attachment_ids" widget="many2many_binary" nolabel="1"/>
                    </group>
                    <group string="Notes">
                        <field name="note" nolabel="1"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_construction_document_search" model="ir.ui.view">
        <field name="name">construction.document.search</field>
        <field name="model">construction.document</field>
        <field name="arch" type="xml">
            <search string="Documents">
                <field name="document_type_id"/>
                <field name="tender_id"/>
                <field name="project_id"/>
                <field name="reference"/>
                <filter name="filter_missing" string="Missing"
                        domain="[('is_required', '=', True), ('is_submitted', '=', False)]"/>
                <filter name="filter_expired" string="Expired"
                        domain="[('is_expired', '=', True)]"/>
                <separator/>
                <filter name="filter_tender" string="Tender Files"
                        domain="[('tender_id', '!=', False)]"/>
                <filter name="filter_project" string="Project Files"
                        domain="[('project_id', '!=', False)]"/>
                <group expand="0" string="Group By">
                    <filter name="group_file_type" string="File"
                            context="{'group_by': 'file_type'}"/>
                    <filter name="group_tender" string="Tender"
                            context="{'group_by': 'tender_id'}"/>
                    <filter name="group_project" string="Project"
                            context="{'group_by': 'project_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_construction_document" model="ir.actions.act_window">
        <field name="name">Documents</field>
        <field name="res_model">construction.document</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_construction_document_search"/>
        <field name="context">{'search_default_filter_missing': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Nothing is missing</p>
            <p>Papers pulled onto a tender or a project show up here until they are provided.</p>
        </field>
    </record>

</odoo>

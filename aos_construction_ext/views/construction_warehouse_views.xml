<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!--
        The site stores profile.

        It keeps the Inventory app, the projects read-only and the material
        requisitions it raises. Everything else in this app is already gated
        on groups it does not carry, so nothing has to be taken away here -
        what this file does is put the two sections it DOES need back, and
        strip the project form down to what it may act on.

        A node or a record is owned by one file; see the note in
        construction_technical_office_views.xml for why.
    -->

    <!-- ============ Project form ============ -->

    <record id="view_construction_project_form_warehouse" model="ir.ui.view">
        <field name="name">construction.project.form.warehouse</field>
        <field name="model">construction.project</field>
        <!-- The extension, not the base form: the handover and bond buttons,
             the documents button and the bond and closure pages are added
             there, and an inherited view is merged into the arch its parent
             has already produced. -->
        <field name="inherit_id" ref="view_construction_project_form_ext"/>
        <field name="arch" type="xml">

            <!-- Read is the only right granted on the project, so Odoo draws
                 the form read-only. The header buttons all write: they would
                 offer a state change and then raise. -->
            <xpath expr="//header/button[@name='action_activate']" position="attributes">
                <attribute name="groups">!aos_construction_ext.group_construction_dept_warehouse</attribute>
            </xpath>
            <xpath expr="//header/button[@name='action_hold']" position="attributes">
                <attribute name="groups">!aos_construction_ext.group_construction_dept_warehouse</attribute>
            </xpath>
            <xpath expr="//header/button[@name='action_complete']" position="attributes">
                <attribute name="groups">!aos_construction_ext.group_construction_dept_warehouse</attribute>
            </xpath>
            <xpath expr="//header/button[@name='action_cancel']" position="attributes">
                <attribute name="groups">!aos_construction_ext.group_construction_dept_warehouse</attribute>
            </xpath>
            <xpath expr="//header/button[@name='action_reset']" position="attributes">
                <attribute name="groups">!aos_construction_ext.group_construction_dept_warehouse</attribute>
            </xpath>
            <xpath expr="//header/button[@name='action_start_handover']" position="attributes">
                <attribute name="groups">!aos_construction_ext.group_construction_dept_warehouse</attribute>
            </xpath>
            <xpath expr="//header/button[@name='action_performance_bond_issued']" position="attributes">
                <attribute name="groups">!aos_construction_ext.group_construction_dept_warehouse</attribute>
            </xpath>
            <xpath expr="//header/button[@name='action_performance_bond_released']" position="attributes">
                <attribute name="groups">!aos_construction_ext.group_construction_dept_warehouse</attribute>
            </xpath>

            <!-- Smart buttons onto screens with no menu behind them for this
                 profile. The requisition button is the one it keeps, and it
                 is set where that node is owned. -->
            <xpath expr="//button[@name='action_view_tender']" position="attributes">
                <attribute name="groups">!aos_construction_ext.group_construction_dept_warehouse</attribute>
            </xpath>
            <xpath expr="//button[@name='action_view_boq']" position="attributes">
                <attribute name="groups">!aos_construction_ext.group_construction_dept_warehouse</attribute>
            </xpath>
            <xpath expr="//button[@name='action_view_wbs']" position="attributes">
                <attribute name="groups">!aos_construction_ext.group_construction_dept_warehouse</attribute>
            </xpath>
            <xpath expr="//button[@name='action_view_work_orders']" position="attributes">
                <attribute name="groups">!aos_construction_ext.group_construction_dept_warehouse</attribute>
            </xpath>
            <xpath expr="//button[@name='action_view_billing']" position="attributes">
                <attribute name="groups">!aos_construction_ext.group_construction_dept_warehouse</attribute>
            </xpath>
            <xpath expr="//button[@name='action_view_documents']" position="attributes">
                <attribute name="groups">!aos_construction_ext.group_construction_dept_warehouse</attribute>
            </xpath>

            <!-- The bond and the closure file are the finance desk's and
                 management's paperwork. The Stores page stays: the warehouse
                 and the site location on it are this desk's own reference. -->
            <xpath expr="//page[@name='performance_bond']" position="attributes">
                <attribute name="groups">!aos_construction_ext.group_construction_dept_warehouse</attribute>
            </xpath>
            <xpath expr="//page[@name='closure']" position="attributes">
                <attribute name="groups">!aos_construction_ext.group_construction_dept_warehouse</attribute>
            </xpath>

        </field>
    </record>

</odoo>

<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_construction_custody_form" model="ir.ui.view">
        <field name="name">construction.custody.form</field>
        <field name="model">construction.custody</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <!-- Open as well as draft: a custody is topped up while
                         the holder still has it, each top-up its own payment. -->
                    <button name="action_open" type="object" string="Hand Over Cash"
                            class="btn-primary" invisible="state != 'draft'"/>
                    <button name="action_open" type="object" string="Hand Over More"
                            invisible="state != 'open'"/>
                    <button name="action_post_settlement" type="object"
                            string="Charge Settlement" class="btn-primary"
                            invisible="state != 'open' or posted_count == line_count"/>
                    <button name="action_settle" type="object" string="Close Custody"
                            invisible="state != 'open'"/>
                    <button name="action_cancel" type="object" string="Cancel"
                            invisible="state not in ('draft', 'open')"/>
                    <button name="action_reset" type="object" string="Reset to Draft"
                            invisible="state != 'cancelled'"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="draft,open,settled"/>
                </header>
                <sheet>
                    <widget name="web_ribbon" title="Cancelled" bg_color="text-bg-danger"
                            invisible="state != 'cancelled'"/>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_payments" type="object"
                                class="oe_stat_button" icon="fa-money"
                                invisible="payment_count == 0">
                            <field name="payment_count" widget="statinfo"
                                   string="Disbursements"/>
                        </button>
                        <button name="action_view_moves" type="object"
                                class="oe_stat_button" icon="fa-book"
                                invisible="move_count == 0">
                            <field name="move_count" widget="statinfo"
                                   string="Expense Entries"/>
                        </button>
                        <button name="action_view_expenses" type="object"
                                class="oe_stat_button" icon="fa-list-alt"
                                invisible="posted_count == 0">
                            <field name="posted_count" widget="statinfo"
                                   string="Charged"/>
                        </button>
                    </div>
                    <div class="oe_title">
                        <h1><field name="ref" readonly="1"/></h1>
                    </div>
                    <group>
                        <group string="Custody">
                            <field name="employee_id"
                                   readonly="state not in ('draft',)"/>
                            <field name="project_id"/>
                            <field name="date"/>
                            <field name="purpose"/>
                        </group>
                        <group string="Money">
                            <!-- The sum of the disbursements once any exist;
                                 typed only when no accounting is set up. -->
                            <field name="amount"
                                   readonly="state not in ('draft',) or payment_count &gt; 0"/>
                            <field name="payment_count" invisible="1"/>
                            <field name="returned_amount"
                                   readonly="state == 'settled'"/>
                            <field name="currency_id" invisible="1"/>
                            <field name="line_count" invisible="1"/>
                            <field name="posted_count" invisible="1"/>
                            <field name="move_count" invisible="1"/>
                            <field name="company_id" invisible="1"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Settlement" name="settlement">
                            <field name="line_ids" readonly="state not in ('draft', 'open')">
                                <!-- A charged line is spent money: it is an
                                     approved expense and it sits in a posted
                                     entry. The model refuses the write either
                                     way; this is so the row says so. -->
                                <list editable="bottom" decoration-muted="is_posted">
                                    <field name="date" readonly="is_posted"/>
                                    <field name="description" readonly="is_posted"/>
                                    <field name="category" readonly="is_posted"/>
                                    <field name="project_id" readonly="is_posted"/>
                                    <field name="wbs_id" optional="hide" readonly="is_posted"/>
                                    <field name="boq_line_id" optional="show" readonly="is_posted"/>
                                    <field name="amount" sum="Settled" readonly="is_posted"/>
                                    <field name="account_id" optional="show" readonly="is_posted"/>
                                    <field name="attachment_ids"
                                           widget="many2many_binary" string="Receipt"/>
                                    <field name="is_posted" optional="show"
                                           readonly="1"/>
                                    <field name="expense_id" optional="hide"
                                           readonly="1"/>
                                    <field name="currency_id" column_invisible="1"/>
                                </list>
                            </field>
                            <group class="oe_subtotal_footer">
                                <field name="settled_amount"/>
                                <field name="returned_amount"/>
                                <field name="balance"
                                       decoration-danger="balance != 0"/>
                            </group>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_construction_custody_list" model="ir.ui.view">
        <field name="name">construction.custody.list</field>
        <field name="model">construction.custody</field>
        <field name="arch" type="xml">
            <list decoration-warning="state == 'open' and balance &gt; 0"
                  decoration-muted="state == 'cancelled'">
                <field name="ref"/>
                <field name="employee_id"/>
                <field name="project_id" optional="show"/>
                <field name="date"/>
                <field name="amount" sum="Issued"/>
                <field name="settled_amount" sum="Settled"/>
                <field name="returned_amount" optional="hide" sum="Returned"/>
                <field name="balance" sum="Balance"/>
                <field name="state" widget="badge"
                       decoration-success="state == 'settled'"
                       decoration-info="state == 'open'"/>
                <field name="currency_id" column_invisible="1"/>
            </list>
        </field>
    </record>

    <record id="view_construction_custody_search" model="ir.ui.view">
        <field name="name">construction.custody.search</field>
        <field name="model">construction.custody</field>
        <field name="arch" type="xml">
            <search>
                <field name="ref"/>
                <field name="employee_id"/>
                <field name="project_id"/>
                <filter name="filter_open" string="With Holder"
                        domain="[('state', '=', 'open')]"/>
                <filter name="filter_outstanding" string="Not Fully Settled"
                        domain="[('state', '=', 'open'), ('balance', '&gt;', 0)]"/>
                <filter name="filter_settled" string="Settled"
                        domain="[('state', '=', 'settled')]"/>
                <separator/>
                <filter name="group_employee" string="Holder"
                        context="{'group_by': 'employee_id'}"/>
                <filter name="group_project" string="Project"
                        context="{'group_by': 'project_id'}"/>
                <filter name="group_state" string="Status"
                        context="{'group_by': 'state'}"/>
            </search>
        </field>
    </record>

    <record id="action_construction_custody" model="ir.actions.act_window">
        <field name="name">Cash Custody</field>
        <field name="res_model">construction.custody</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'search_default_filter_open': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Record the cash the site is holding</p>
            <p>Hand the money over, collect the receipts, and each one is charged
               to the project it was spent for.</p>
        </field>
    </record>

</odoo>

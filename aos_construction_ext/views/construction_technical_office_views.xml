<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!--
        The technical office profile.

        It carries ``group_construction_dept_technical`` and, unlike every
        other desk, NOT ``group_construction_user``. Six screens stay: tenders,
        projects, the bill of quantities, planning, documents and payment
        certificates. Procurement, expenses, the dashboard and configuration go
        away, and so does every other app.

        Everything here is hidden by REQUIRING a group, never by excluding
        one. ``groups="!something"`` on a view node is NOT honoured in Odoo 19:
        the node stays in the arch and the user sees it, with no error and no
        warning. Verified on this database against get_views for a user in the
        excluded group - a positive spec on the same node stripped it, the
        negated one did not. Every profile here was written with negation
        first, and none of it was doing anything.

        So ``group_construction_user`` carries the weight: every full desk has
        it and none of the four narrow profiles do, which makes it the marker
        for "sees the whole app". A node a narrow profile is meant to keep
        names that profile as a second positive group. A node it writes to -
        the technical office writes projects, the others only read them -
        names the technical office too.

        A node must be touched from ONE view only: two inherited views doing
        position="attributes" on the same node fight over the attribute and
        the winner depends on view order. The project form is split between
        this file and construction_purchasing_views.xml and nothing repeats.

        ``groups`` written on the <xpath> element itself is consumed while the
        views are merged and dropped before access rights are applied - it is
        ignored in silence too. It has to sit on the node, as an
        <attribute>.
    -->

    <!-- ============ Menus ============ -->

    <!-- The dashboard is an ir.actions.client with no model behind it, so no
         amount of access rights will hide it. It also leads with approved
         expenses and actual cost. -->
    <record id="aos_construction_management.menu_construction_dashboard" model="ir.ui.menu">
        <field name="group_ids" eval="[(6, 0, [ref('aos_construction_management.group_construction_user')])]"/>
    </record>

    <!-- Procurement is the purchasing desk's section, so it names that group
         as well: a menu is shown when the user is in ANY of its groups. -->
    <record id="aos_construction_management.menu_construction_procurement" model="ir.ui.menu">
        <field name="group_ids" eval="[(6, 0, [
            ref('aos_construction_management.group_construction_user'),
            ref('group_construction_dept_purchasing'),
            ref('group_construction_dept_warehouse')])]"/>
    </record>

    <!-- Expenses, the custodies and the salary distribution are the
         accountant's work, so that group is named here as well. -->
    <record id="aos_construction_management.menu_construction_expenses" model="ir.ui.menu">
        <field name="group_ids" eval="[(6, 0, [
            ref('aos_construction_management.group_construction_user'),
            ref('group_construction_dept_accounting')])]"/>
    </record>

    <!-- Quality keeps its feature-toggle group on the parent menu; the child is
         what actually opens a screen, so gating it hides the section without
         touching the toggle. -->
    <record id="aos_construction_management.menu_construction_quality_check" model="ir.ui.menu">
        <field name="group_ids" eval="[(6, 0, [ref('aos_construction_management.group_construction_user')])]"/>
    </record>

    <!-- ============ Project form ============ -->

    <record id="view_construction_project_form_tech_office" model="ir.ui.view">
        <field name="name">construction.project.form.tech.office</field>
        <field name="model">construction.project</field>
        <field name="inherit_id" ref="aos_construction_management.view_construction_project_form"/>
        <field name="arch" type="xml">

            <!--
                The money on this form is read from purchase orders, journal
                entries and expenses. The technical office is walled off from
                all three by record rules, so these figures would not be
                hidden - they would be WRONG: a zero that reads like a fact.
                Actual cost, for instance, would drop its purchase and expense
                components and keep only the subcontracts.
            -->
            <xpath expr="//field[@name='invoiced_revenue']" position="attributes">
                <attribute name="groups">aos_construction_management.group_construction_user,aos_construction_ext.group_construction_dept_accounting</attribute>
            </xpath>
            <xpath expr="//field[@name='committed_cost']" position="attributes">
                <attribute name="groups">aos_construction_management.group_construction_user,aos_construction_ext.group_construction_dept_purchasing,aos_construction_ext.group_construction_dept_accounting</attribute>
            </xpath>
            <xpath expr="//field[@name='actual_cost']" position="attributes">
                <attribute name="groups">aos_construction_management.group_construction_user,aos_construction_ext.group_construction_dept_accounting</attribute>
            </xpath>
            <xpath expr="//field[@name='total_expenses']" position="attributes">
                <attribute name="groups">aos_construction_management.group_construction_user,aos_construction_ext.group_construction_dept_accounting</attribute>
            </xpath>
            <!-- customer_certified_total belongs next to these, but it is
                 added by this module's own extension of the form, not by the
                 base. This view inherits the base, so the node is only there
                 if the extension happened to be merged first. It is gated
                 from construction_purchasing_views.xml instead, which names
                 the extension as its parent and is therefore sure of it. -->
            <!-- gross_margin already carries the margin group, which the
                 technical office is not in. Left alone. -->

            <!-- Smart buttons onto the screens this profile does not have. -->
            <xpath expr="//button[@name='action_view_requisitions']" position="attributes">
                <attribute name="groups">aos_construction_management.group_construction_user,aos_construction_ext.group_construction_dept_purchasing,aos_construction_ext.group_construction_dept_warehouse</attribute>
            </xpath>
            <xpath expr="//button[@name='action_view_subcontracts']" position="attributes">
                <attribute name="groups">aos_construction_management.group_construction_user</attribute>
            </xpath>
            <xpath expr="//button[@name='action_view_expenses']" position="attributes">
                <attribute name="groups">aos_construction_management.group_construction_user,aos_construction_ext.group_construction_dept_accounting</attribute>
            </xpath>
            <xpath expr="//button[@name='action_view_purchase_orders']" position="attributes">
                <attribute name="groups">aos_construction_management.group_construction_user,aos_construction_ext.group_construction_dept_purchasing,aos_construction_ext.group_construction_dept_accounting</attribute>
            </xpath>
            <xpath expr="//button[@name='action_view_vendor_bills']" position="attributes">
                <attribute name="groups">aos_construction_management.group_construction_user,aos_construction_ext.group_construction_dept_accounting</attribute>
            </xpath>
            <xpath expr="//button[@name='action_view_customer_invoices']" position="attributes">
                <attribute name="groups">aos_construction_management.group_construction_user,aos_construction_ext.group_construction_dept_accounting</attribute>
            </xpath>
            <xpath expr="//button[@name='action_view_quality']" position="attributes">
                <attribute name="groups">aos_construction_ext.group_construction_quality</attribute>
            </xpath>

        </field>
    </record>

</odoo>

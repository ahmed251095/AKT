<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_construction_boq_form_ext" model="ir.ui.view">
        <field name="name">construction.boq.form.ext</field>
        <field name="model">construction.boq</field>
        <field name="inherit_id" ref="aos_construction_management.view_construction_boq_form"/>
        <field name="arch" type="xml">

            <!-- invisible="1" hides a cell's value, not its column. -->
            <xpath expr="//field[@name='line_ids']/list/field[@name='currency_id']"
                   position="attributes">
                <attribute name="column_invisible">1</attribute>
                <attribute name="invisible"/>
            </xpath>

            <!-- The office reads the description, not a number off a sheet. The
                 section flag still drives what the other columns show, so it
                 stays in the view without a column. -->
            <xpath expr="//field[@name='line_ids']/list/field[@name='item_no']"
                   position="replace"/>
            <xpath expr="//field[@name='line_ids']/list/field[@name='is_section']"
                   position="attributes">
                <attribute name="column_invisible">1</attribute>
            </xpath>

            <xpath expr="//field[@name='line_ids']/list/field[@name='unit_rate']" position="before">
                <field name="use_pricing_formula" optional="hide"/>
                <field name="dry_cost" optional="hide" sum="Dry Cost"/>
                <field name="operating_cost" optional="hide" sum="Operating Cost"/>
                <field name="base_cost" optional="show" sum="Base Cost"/>
                <field name="profit_percent" optional="hide"/>
                <field name="contingency_percent" optional="hide"/>
                <field name="admin_percent" optional="hide"/>
                <field name="markup_percent" optional="show"/>
                <field name="expense_percent" optional="hide"/>
                <field name="price_before_tax" optional="hide"/>
                <field name="tax_ids" widget="many2many_tags" optional="hide"/>
                <field name="tax_percent" optional="hide"/>
                <field name="tax_amount" optional="hide"/>
            </xpath>

            <xpath expr="//field[@name='line_ids']/list/field[@name='unit_rate']" position="attributes">
                <attribute name="readonly">use_pricing_formula</attribute>
            </xpath>

            <!-- The same figure as the base cost while the formula is on, so it
                 stays off the table; a lump-sum item is priced by typing it, so
                 it has to remain reachable from the column picker. -->
            <xpath expr="//field[@name='line_ids']/list/field[@name='cost_rate']" position="attributes">
                <attribute name="readonly">use_pricing_formula</attribute>
                <attribute name="optional">hide</attribute>
            </xpath>

            <!-- Over-run is the number the site argues about, so it belongs
                 next to the executed quantity rather than in a report. -->
            <xpath expr="//field[@name='line_ids']/list/field[@name='budget_cost']" position="after">
                <field name="expected_cost" optional="hide" sum="Expected Cost"/>
                <field name="expected_margin" optional="hide" sum="Expected Margin"/>
                <field name="expected_margin_percent" optional="hide"/>
            </xpath>

            <xpath expr="//field[@name='line_ids']/list/field[@name='executed_qty']" position="before">
                <field name="own_progress_qty" optional="show"/>
                <field name="subcontract_progress_qty" optional="show"/>
                <field name="progress_qty" optional="show"/>
            </xpath>

            <xpath expr="//field[@name='line_ids']/list/field[@name='executed_qty']" position="after">
                <field name="qty_variance" optional="hide"/>
                <field name="variance_cost" optional="hide" sum="Variance Cost"/>
                <field name="is_overrun" column_invisible="1"/>
                <field name="tender_line_id" optional="hide"/>
            </xpath>

            <xpath expr="//field[@name='line_ids']/list" position="attributes">
                <attribute name="decoration-danger">is_overrun</attribute>
            </xpath>


            <!-- The columns in the order the estimator reads them: what the item
                 costs, what the budget carries, the markup, the sell rate, the
                 money and what is left of it. -->
            <xpath expr="//field[@name='line_ids']/list/field[@name='base_cost']" position="after">
                <xpath expr="//field[@name='line_ids']/list/field[@name='budget_cost']" position="move"/>
            </xpath>
            <xpath expr="//field[@name='line_ids']/list/field[@name='budget_cost']" position="after">
                <xpath expr="//field[@name='line_ids']/list/field[@name='markup_percent']" position="move"/>
            </xpath>
            <xpath expr="//field[@name='line_ids']/list/field[@name='markup_percent']" position="after">
                <xpath expr="//field[@name='line_ids']/list/field[@name='unit_rate']" position="move"/>
            </xpath>
            <xpath expr="//field[@name='line_ids']/list/field[@name='unit_rate']" position="after">
                <xpath expr="//field[@name='line_ids']/list/field[@name='amount']" position="move"/>
            </xpath>
            <xpath expr="//field[@name='line_ids']/list/field[@name='amount']" position="after">
                <xpath expr="//field[@name='line_ids']/list/field[@name='budget_margin']" position="move"/>
            </xpath>

        </field>
    </record>

</odoo>

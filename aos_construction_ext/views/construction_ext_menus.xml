<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <menuitem id="menu_construction_documents"
              name="Documents"
              parent="aos_construction_management.menu_construction_root"
              action="action_construction_document"
              sequence="55"/>

    <record id="aos_construction_management.menu_construction_quality" model="ir.ui.menu">
        <field name="groups_id" eval="[(6, 0, [ref('group_construction_quality')])]"/>
    </record>

    <!-- Expenses stops being a list of its own and becomes the section the
         money-out screens sit in. -->
    <record id="aos_construction_management.menu_construction_expenses" model="ir.ui.menu">
        <field name="action" eval="False"/>
    </record>

    <menuitem id="menu_construction_expense_list"
              name="Expenses"
              parent="aos_construction_management.menu_construction_expenses"
              action="aos_construction_management.action_construction_expense"
              sequence="10"/>

    <menuitem id="menu_construction_custody"
              name="Cash Custody"
              parent="aos_construction_management.menu_construction_expenses"
              action="action_construction_custody"
              sequence="20"/>

    <menuitem id="menu_construction_authority_type"
              name="Authority Types"
              parent="aos_construction_management.menu_construction_configuration"
              action="action_construction_authority_type"
              sequence="10"/>

    <menuitem id="menu_construction_document_type"
              name="Document Types"
              parent="aos_construction_management.menu_construction_configuration"
              action="action_construction_document_type"
              sequence="20"/>

    <menuitem id="menu_construction_ext_settings"
              name="Settings"
              parent="aos_construction_management.menu_construction_configuration"
              action="action_construction_ext_config_settings"
              groups="aos_construction_management.group_construction_manager"
              sequence="1"/>

    <!--
        Progress Billing bills a percentage of the contract typed by hand,
        unconnected to the bill of quantities and invisible to the profit
        statement, so it is a second way to bill the same work that nothing
        reconciles. Payment certificates carry the quantities and the money.
        The model is left in place; only the way in is closed.
    -->
    <record id="aos_construction_management.menu_construction_progress_billing" model="ir.ui.menu">
        <field name="active" eval="False"/>
    </record>

</odoo>

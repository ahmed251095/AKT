<?xml version="1.0" encoding="utf-8"?>
<odoo>

  <record id="view_construction_material_requisition_form_ext" model="ir.ui.view">
    <field name="name">construction.material.requisition.form.ext</field>
    <field name="model">construction.material.requisition</field>
    <field name="inherit_id" ref="aos_construction_management.view_construction_material_requisition_form"/>
    <field name="arch" type="xml">
      <!-- A requisition says what the site needs and how much of it. Money on
           this screen invites approving a price that only the vendor can
           state, and the quotation has its own approval for that. -->
      <!-- An item is not owned by a phase any more, so the whole bill is
           offered and the requisition takes what it needs. -->
      <xpath expr="//field[@name='line_ids']/list/field[@name='boq_line_id']" position="attributes">
        <attribute name="domain">[('boq_id.project_id', '=', parent.project_id), ('is_section', '=', False)]</attribute>
      </xpath>

      <!-- The reference is the title; there is no second name to type. -->
      <xpath expr="//div[hasclass('oe_title')]" position="replace">
        <div class="oe_title">
          <h1><field name="ref" readonly="1"/></h1>
        </div>
      </xpath>

      <xpath expr="//field[@name='line_ids']/list/field[@name='unit_price']" position="attributes">
        <attribute name="column_invisible">1</attribute>
      </xpath>
      <xpath expr="//field[@name='line_ids']/list/field[@name='subtotal']" position="attributes">
        <attribute name="column_invisible">1</attribute>
      </xpath>
      <xpath expr="//field[@name='total_estimated_cost']" position="attributes">
        <attribute name="invisible">1</attribute>
      </xpath>
    </field>
  </record>

  <record id="view_construction_material_requisition_list_ext" model="ir.ui.view">
    <field name="name">construction.material.requisition.list.ext</field>
    <field name="model">construction.material.requisition</field>
    <field name="inherit_id" ref="aos_construction_management.view_construction_material_requisition_list"/>
    <field name="arch" type="xml">
      
      <xpath expr="//field[@name='name']" position="replace"/>
<xpath expr="//field[@name='total_estimated_cost']" position="attributes">
        <attribute name="column_invisible">1</attribute>
      </xpath>
    </field>
  </record>

  <record id="view_purchase_order_form_construction_ext" model="ir.ui.view">
    <field name="name">purchase.order.form.construction.ext</field>
    <field name="model">purchase.order</field>
    <field name="inherit_id" ref="purchase.purchase_order_form"/>
    <field name="arch" type="xml">
      <xpath expr="//field[@name='order_line']/list/field[@name='price_unit']" position="before">
        <field name="construction_boq_line_id" column_invisible="1"/>
        <field name="boq_cost_rate" readonly="1" optional="show"/>
      </xpath>
      <xpath expr="//field[@name='order_line']/list/field[@name='price_unit']" position="after">
        <field name="price_over_boq_rate" readonly="1" optional="show"/>
      </xpath>
    </field>
  </record>

</odoo>

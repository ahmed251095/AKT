<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_construction_tender_reject_form" model="ir.ui.view">
        <field name="name">construction.tender.reject.form</field>
        <field name="model">construction.tender.reject</field>
        <field name="arch" type="xml">
            <form string="Reject Tender">
                <field name="tender_id" invisible="1"/>
                <group>
                    <field name="reason" placeholder="Why is this operation not worth opening?"/>
                </group>
                <footer>
                    <button name="action_confirm" type="object" string="Reject" class="btn-primary"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

</odoo>

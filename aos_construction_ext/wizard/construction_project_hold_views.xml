<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_construction_project_hold_form" model="ir.ui.view">
        <field name="name">construction.project.hold.form</field>
        <field name="model">construction.project.hold</field>
        <field name="arch" type="xml">
            <form string="Hold Project">
                <field name="project_id" invisible="1"/>
                <group>
                    <field name="reason" placeholder="Why is the site stopping, and what unblocks it?"/>
                </group>
                <footer>
                    <button name="action_confirm" type="object" string="Hold" class="btn-primary"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

</odoo>

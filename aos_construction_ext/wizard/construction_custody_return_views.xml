<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_construction_custody_return_form" model="ir.ui.view">
        <field name="name">construction.custody.return.form</field>
        <field name="model">construction.custody.return</field>
        <field name="arch" type="xml">
            <form string="Return Custody Cash">
                <group>
                    <group>
                        <field name="custody_id" invisible="1"/>
                        <field name="currency_id" invisible="1"/>
                        <field name="employee_id" readonly="1"/>
                        <field name="balance" readonly="1"/>
                    </group>
                    <group>
                        <field name="journal_id" options="{'no_create': True}"/>
                        <field name="amount"/>
                        <field name="date"/>
                    </group>
                </group>
                <group>
                    <field name="memo" nolabel="1" placeholder="Memo..."/>
                </group>
                <footer>
                    <button name="action_return" type="object"
                            string="Return Cash" class="btn-primary"/>
                    <button string="Cancel" class="btn-secondary"
                            special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

</odoo>

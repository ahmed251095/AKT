<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <record id="authority_type_endowment" model="construction.authority.type">
            <field name="name">Endowments Authority</field>
            <field name="code">AWQAF</field>
            <field name="sequence">10</field>
            <field name="is_government" eval="True"/>
            <field name="default_bid_bond_percent">2.0</field>
        </record>

        <record id="authority_type_agricultural" model="construction.authority.type">
            <field name="name">Agricultural Company</field>
            <field name="code">AGRI</field>
            <field name="sequence">20</field>
            <field name="default_bid_bond_percent">2.0</field>
        </record>

        <record id="authority_type_government" model="construction.authority.type">
            <field name="name">Government Body</field>
            <field name="code">GOV</field>
            <field name="sequence">30</field>
            <field name="is_government" eval="True"/>
            <field name="default_bid_bond_percent">2.0</field>
        </record>

        <record id="authority_type_military" model="construction.authority.type">
            <field name="name">Military Entity</field>
            <field name="code">MIL</field>
            <field name="sequence">40</field>
            <field name="is_government" eval="True"/>
            <field name="default_bid_bond_percent">2.0</field>
        </record>

        <record id="authority_type_private" model="construction.authority.type">
            <field name="name">Private Owner</field>
            <field name="code">PRIV</field>
            <field name="sequence">50</field>
            <field name="default_bid_bond_percent">0.0</field>
        </record>

    </data>
</odoo>

<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <!-- Margin is not for every pair of eyes on the file: the estimator
             and the site see the rates, the margin is management's. Granted
             per user, never implied by default. -->
        <record id="group_construction_margin" model="res.groups">
            <field name="name">Construction / Margin</field>
            <field name="comment">Sees the margin on tender items and on the tender totals.</field>
        </record>

        <!-- A phase tree is not how every contractor works: a small job is a
             flat list of phases. Switched off, the parent phase and the
             sub-phase tab go away and the records keep whatever links they
             already have. -->
        <record id="group_construction_wbs_hierarchy" model="res.groups">
            <field name="name">Construction / Sub-phases</field>
            <field name="comment">Breaks a work phase into sub-phases under a parent phase.</field>
        </record>

        <!-- Quality control is a module option: a contractor who does not run
             site inspections switches it off and the screens go away. Held as
             a group because that is what hides a menu in Odoo. -->
        <record id="group_construction_quality" model="res.groups">
            <field name="name">Construction / Quality Control</field>
            <field name="comment">Site quality inspections and their checklists.</field>
        </record>

        <!-- The six departments the company is organised in. They are plain
             checkbox groups, like the ones the base module ships, so one
             person can carry two hats in a small office. -->

        <record id="group_construction_dept_management" model="res.groups">
            <field name="name">Construction / Management</field>
            <field name="comment">Approves opening an operation, releases the budget and reviews project accounts.</field>
            <field name="implied_ids" eval="[(4, ref('aos_construction_management.group_construction_manager'))]"/>
        </record>

        <record id="group_construction_dept_execution" model="res.groups">
            <field name="name">Construction / Site Execution</field>
            <field name="comment">Runs the work orders on site and reports executed quantities.</field>
            <field name="implied_ids" eval="[(4, ref('aos_construction_management.group_construction_user'))]"/>
        </record>

        <record id="group_construction_dept_finance" model="res.groups">
            <field name="name">Construction / Finance &amp; Contracts</field>
            <field name="comment">Owns the bonds, the booklet fee, the certificates and the project accounts.</field>
            <field name="implied_ids" eval="[(4, ref('aos_construction_management.group_construction_user'))]"/>
        </record>

        <record id="group_construction_dept_warehouse" model="res.groups">
            <field name="name">Construction / Warehouses</field>
            <field name="comment">Receives and issues materials against the site stores.</field>
            <field name="implied_ids" eval="[(4, ref('aos_construction_management.group_construction_user'))]"/>
        </record>

        <record id="group_construction_dept_hr_purchase" model="res.groups">
            <field name="name">Construction / HR &amp; Purchasing</field>
            <field name="comment">Staffs the sites, follows up employee cases and buys what the requisitions ask for.</field>
            <field name="implied_ids" eval="[(4, ref('aos_construction_management.group_construction_user'))]"/>
        </record>

    </data>

    <!--
        The technical office is the one department that is NOT a construction
        user with extra hats: it is a narrower profile that sees six screens
        and nothing else. That is why it implies ``base.group_user`` only and
        never ``group_construction_user``.

        ``group_construction_user`` is what every other desk carries, so it
        doubles as the marker for "sees the whole app": the menus and the money
        fields the technical office must not reach are gated on it, and the
        technical office is the only profile without it. Each model it does
        need is granted to this group by name in ir.model.access.csv.

        Kept outside the noupdate block above on purpose. The record already
        exists on the database from an earlier version, and a noupdate record
        is skipped in silence on upgrade - the build goes green and the group
        keeps its old implied_ids.
    -->
    <record id="group_construction_dept_technical" model="res.groups">
        <field name="name">Construction / Technical Office</field>
        <field name="comment">Studies the tender documents, prices the items and issues the bill of quantities. Sees tenders, projects, the bill of quantities, planning, documents and payment certificates - nothing else, in this app or any other.</field>
        <field name="implied_ids" eval="[(6, 0, [ref('base.group_user')])]"/>
    </record>

    <!-- Outside the noupdate block on purpose: this updates base.group_user,
         which already exists, and a noupdate record would be skipped. -->
    <record id="base.group_user" model="res.groups">
        <field name="implied_ids" eval="[(4, ref('group_construction_quality')), (4, ref('group_construction_wbs_hierarchy'))]"/>
    </record>
</odoo>

<?xml version="1.0" encoding="utf-8"?>
<odoo>
 <record id="view_construction_subcontract_list" model="ir.ui.view"><field name="name">construction.subcontract.list</field><field name="model">construction.subcontract</field><field name="arch" type="xml"><list><field name="ref"/><field name="name"/><field name="project_id"/><field name="subcontractor_id"/><field name="contract_value"/><field name="certified_amount"/><field name="billed_amount"/><field name="paid_amount"/><field name="amount_remaining"/><field name="state" widget="badge"/></list></field></record>
 <record id="view_construction_subcontract_form" model="ir.ui.view"><field name="name">construction.subcontract.form</field><field name="model">construction.subcontract</field><field name="arch" type="xml"><form>
  <header><button name="action_activate" type="object" string="Activate" invisible="state != 'draft'" class="btn-primary"/><button name="action_create_purchase_order" type="object" string="Create/Open PO" invisible="state == 'terminated'"/><button name="action_create_certificate" type="object" string="New Certificate" invisible="state != 'active'" class="btn-primary"/><button name="action_complete" type="object" string="Complete" invisible="state != 'active'"/><button name="action_terminate" type="object" string="Terminate" invisible="state not in ('draft','active')"/><button name="action_reset" type="object" string="Reset" invisible="state != 'terminated'"/><field name="state" widget="statusbar" statusbar_visible="draft,active,completed"/></header>
  <sheet><div class="oe_button_box" name="button_box"><button name="action_view_certificates" type="object" class="oe_stat_button" icon="fa-file-text-o"><field name="billing_count" widget="statinfo" string="Certificates"/></button></div>
  <div class="oe_title"><label for="name"/><h1><field name="name"/></h1><field name="ref" readonly="1"/></div>
  <group><group string="Contract"><field name="project_id"/><field name="wbs_id"/><field name="subcontractor_id"/><field name="product_id"/><field name="purchase_order_id"/></group><group string="Dates &amp; Terms"><field name="start_date"/><field name="end_date"/><field name="payment_term_id"/><field name="retention_percent"/><field name="advance_percent"/></group></group>
  <group string="Financial Control"><field name="contract_value"/><field name="certified_amount"/><field name="billed_amount"/><field name="paid_amount"/><field name="amount_remaining"/><field name="retention_amount"/><field name="currency_id" invisible="1"/></group>
  <notebook><page string="Scope"><field name="scope_of_work"/></page><page string="Payment Terms"><field name="payment_terms"/></page><page string="Certificates"><field name="billing_ids" readonly="1"><list><field name="ref"/><field name="billing_date"/><field name="net_amount"/><field name="retention_amount"/><field name="net_payable"/><field name="state"/></list></field></page></notebook></sheet><chatter/>
 </form></field></record>
 <record id="action_construction_subcontract" model="ir.actions.act_window"><field name="name">Subcontracts</field><field name="res_model">construction.subcontract</field><field name="view_mode">list,form</field></record>
</odoo>

<?xml version="1.0" encoding="utf-8"?>
<odoo>
 <record id="view_construction_ra_billing_list" model="ir.ui.view"><field name="name">construction.ra.billing.list</field><field name="model">construction.ra.billing</field><field name="arch" type="xml"><list><field name="ref"/><field name="name"/><field name="billing_type"/><field name="project_id"/><field name="partner_id"/><field name="billing_date"/><field name="total_amount"/><field name="retention_amount"/><field name="net_payable"/><field name="move_id"/><field name="state" widget="badge"/></list></field></record>
 <record id="view_construction_ra_billing_form" model="ir.ui.view"><field name="name">construction.ra.billing.form</field><field name="model">construction.ra.billing</field><field name="arch" type="xml"><form>
  <header><button name="action_submit" type="object" string="Submit" invisible="state != 'draft'" class="btn-primary"/><button name="action_approve" type="object" string="Approve" invisible="state != 'submitted'" class="btn-primary"/><button name="action_create_account_move" type="object" string="Create Invoice / Bill" invisible="state != 'approved'" class="btn-primary"/><button name="action_view_account_move" type="object" string="Open Invoice / Bill" invisible="not move_id"/><button name="action_mark_paid" type="object" string="Mark Paid" invisible="state != 'invoiced'"/><button name="action_cancel" type="object" string="Cancel" invisible="state in ('paid','cancelled')"/><button name="action_reset" type="object" string="Reset" invisible="state not in ('submitted','cancelled')"/><field name="state" widget="statusbar" statusbar_visible="draft,submitted,approved,invoiced,paid"/></header>
  <sheet><div class="oe_title"><label for="name"/><h1><field name="name"/></h1><field name="ref" readonly="1"/></div>
  <group><group string="Certificate"><field name="billing_type"/><field name="project_id"/><field name="partner_id"/><field name="subcontract_id" invisible="billing_type != 'subcontractor'"/><field name="purchase_order_id" invisible="billing_type != 'subcontractor'"/><field name="move_id" readonly="1"/></group><group string="Period"><field name="billing_date"/><field name="billing_period_start"/><field name="billing_period_end"/><field name="previous_billed" readonly="1"/><field name="tax_ids" widget="many2many_tags"/></group></group>
  <field name="line_ids"><list editable="bottom"><field name="boq_line_id"/><field name="wbs_id"/><field name="work_order_id"/><field name="product_id"/><field name="boq_line_description"/><field name="work_type"/><field name="uom_id"/><field name="boq_qty"/><field name="qty_previous"/><field name="qty_current"/><field name="qty_cumulative" readonly="1"/><field name="qty_remaining" readonly="1"/><field name="progress_percent" widget="percentage" readonly="1"/><field name="unit_rate"/><field name="amount" readonly="1"/></list></field>
  <group><group/><group string="Summary"><field name="total_amount"/><field name="retention_percent"/><field name="retention_amount"/><field name="advance_recovery"/><field name="other_deductions"/><field name="net_payable" class="oe_subtotal_footer_separator"/><field name="currency_id" invisible="1"/></group></group><field name="notes"/></sheet><chatter/>
 </form></field></record>
 <record id="action_construction_ra_billing" model="ir.actions.act_window"><field name="name">Payment Certificates</field><field name="res_model">construction.ra.billing</field><field name="view_mode">list,form</field></record>
 <record id="view_construction_progress_billing_list" model="ir.ui.view"><field name="name">construction.progress.billing.list</field><field name="model">construction.progress.billing</field><field name="arch" type="xml"><list><field name="ref"/><field name="name"/><field name="project_id"/><field name="billing_date"/><field name="percent_complete"/><field name="amount_this_period"/><field name="state"/></list></field></record>
 <record id="view_construction_progress_billing_form" model="ir.ui.view"><field name="name">construction.progress.billing.form</field><field name="model">construction.progress.billing</field><field name="arch" type="xml"><form><header><button name="action_approve" type="object" string="Approve" invisible="state != 'draft'"/><button name="action_invoice" type="object" string="Mark Invoiced" invisible="state != 'approved'"/><field name="state" widget="statusbar"/></header><sheet><group><field name="name"/><field name="ref"/><field name="project_id"/><field name="billing_date"/><field name="contract_value"/><field name="percent_complete"/><field name="amount_earned"/><field name="amount_previously_billed"/><field name="amount_this_period"/><field name="currency_id" invisible="1"/></group><field name="notes"/></sheet><chatter/></form></field></record>
 <record id="action_construction_progress_billing" model="ir.actions.act_window"><field name="name">Progress Billing</field><field name="res_model">construction.progress.billing</field><field name="view_mode">list,form</field></record>
</odoo>

<?xml version="1.0" encoding="utf-8"?>
<odoo>
 <record id="view_construction_material_requisition_list" model="ir.ui.view"><field name="name">construction.material.requisition.list</field><field name="model">construction.material.requisition</field><field name="arch" type="xml"><list><field name="ref"/><field name="name"/><field name="project_id"/><field name="vendor_id"/><field name="date_required"/><field name="total_estimated_cost"/><field name="purchase_order_count"/><field name="state" widget="badge"/></list></field></record>
 <record id="view_construction_material_requisition_form" model="ir.ui.view"><field name="name">construction.material.requisition.form</field><field name="model">construction.material.requisition</field><field name="arch" type="xml"><form>
  <header><button name="action_submit" type="object" string="Submit" invisible="state != 'draft'" class="btn-primary"/><button name="action_approve" type="object" string="Approve" invisible="state != 'submitted'" class="btn-primary"/><button name="action_create_rfq" type="object" string="Create RFQ" invisible="state not in ('approved','rfq')" class="btn-primary"/><button name="action_receive" type="object" string="Mark Received" invisible="state not in ('rfq','ordered')"/><button name="action_cancel" type="object" string="Cancel" invisible="state in ('received','cancelled')"/><button name="action_reset" type="object" string="Reset" invisible="state != 'cancelled'"/><field name="state" widget="statusbar" statusbar_visible="draft,submitted,approved,rfq,ordered,received"/></header>
  <sheet><div class="oe_button_box" name="button_box"><button name="action_view_purchase_orders" type="object" class="oe_stat_button" icon="fa-shopping-cart"><field name="purchase_order_count" widget="statinfo" string="RFQs &amp; POs"/></button></div><div class="oe_title"><label for="name"/><h1><field name="name"/></h1><field name="ref" readonly="1"/></div>
  <group><group><field name="project_id"/><field name="wbs_id"/>
                            <field name="work_order_id"/><field name="vendor_id"/></group><group><field name="date_requested"/><field name="date_required"/><field name="requested_by"/><field name="approved_by" readonly="1"/></group></group>
  <field name="line_ids"><list editable="bottom"><field name="boq_line_id"/>
                            <field name="product_id"/><field name="description"/><field name="uom_id"/><field name="qty_requested"/><field name="qty_approved"/><field name="qty_received"/><field name="unit_price"/><field name="subtotal" readonly="1"/></list></field>
  <group class="oe_subtotal_footer"><field name="total_estimated_cost"/><field name="currency_id" invisible="1"/></group><field name="notes" placeholder="Technical specifications, delivery instructions..."/></sheet><chatter/>
 </form></field></record>
 <record id="action_construction_material_requisition" model="ir.actions.act_window"><field name="name">Material Requisitions</field><field name="res_model">construction.material.requisition</field><field name="view_mode">list,form</field></record>
</odoo>

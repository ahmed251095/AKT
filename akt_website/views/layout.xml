<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <!--
    Odoo's own header and footer are swapped for the site's, and <main> gets
    the id the skip link points at. The page's own markup still goes inside
    <main>, so the builder edits it exactly as it would any other page.
  -->
  <template id="layout" inherit_id="website.layout" name="AKT Group layout">

    <xpath expr="//header" position="replace"><header class="site-header" data-name="Header"><div class="container header-inner"><a class="brand" href="/" aria-label="AKT Group"><span class="gold-text">AKT GROUP</span></a><button class="menu-toggle" type="button" aria-expanded="false" aria-controls="primary-nav">Menu<span aria-hidden="true">☰</span></button><nav id="primary-nav" aria-label="Main navigation">
        <t t-foreach="website.menu_id.child_id" t-as="akt_menu">
          <details t-if="akt_menu.child_id" class="nav-more">
            <summary t-out="akt_menu.name"/>
            <div>
              <a t-foreach="akt_menu.child_id" t-as="akt_sub"
                 t-att-href="akt_sub.url" t-out="akt_sub.name"/>
            </div>
          </details>
          <a t-else="" t-att-href="akt_menu.url" t-out="akt_menu.name"/>
        </t>
      </nav><t t-set="akt_switch_labels" t-value="{'ar': 'عربي', 'en': 'EN'}"/>
      <t t-foreach="frontend_languages.values()" t-as="akt_lg">
        <t t-if="akt_lg.code != lang">
          <t t-set="akt_path" t-value="main_object.url if main_object and 'url' in main_object._fields and main_object.url != '/' else ''"/>
          <a class="language-switch js_change_lang"
             t-att-lang="akt_lg.url_code"
             t-att-data-url_code="akt_lg.url_code"
             t-attf-href="/#{akt_lg.url_code}#{akt_path}"
             t-out="akt_switch_labels.get(akt_lg.url_code, akt_lg.url_code.upper())"/>
        </t>
      </t><a class="akt-btn header-cta" href="/quotation">Start a project</a></div></header></xpath>

    <xpath expr="//footer" position="replace"><footer class="site-footer" id="bottom" data-name="Footer"><div class="container footer-grid"><div><a class="brand" href="/">AKT <b>GROUP</b></a><p>AKT Group For General Contracting and Development</p><p class="muted">General contracting, real estate development and engineering projects.</p></div><div><h2>Explore</h2><a href="/appointments">Request a visit or call</a><a href="/partners/register">Supplier &amp; subcontractor registration</a><a href="/careers">Careers</a><a href="/updates">Project updates</a><a href="/quotation">Request a quotation</a><span class="footer-pending" aria-disabled="true">Company profile (PDF) — not added yet</span><a href="/portfolio">Portfolio</a><a href="/pages/consultancy">Engineering consultancy</a><a href="/pages/technical-office">Technical office</a><a href="/contact">Get in touch</a></div><div><h2>Services &amp; sectors</h2><a href="/services/general-contracting">General contracting</a><a href="/services/construction-development">Construction &amp; real estate development</a><a href="/services/industrial-projects">Industrial projects</a><a href="/services/residential-projects">Residential projects</a><a href="/services/administrative-projects">Administrative projects</a><a href="/sectors/industrial">Industrial</a><a href="/sectors/residential">Residential</a><a href="/sectors/administrative">Administrative</a><a href="/sectors/government">Government</a></div><div><h2>Contact</h2><a href="tel:+201200006655"><bdi>01200006655</bdi></a><a href="mailto:elfakharany@akt-group.com"><bdi>elfakharany@akt-group.com</bdi></a><p>Abdel Salam El Shazly Street, Damanhour, Beheira, Egypt</p></div><div><h2>Follow us</h2><div class="social-links"><span class="social-item is-disabled" aria-disabled="true" title="Facebook — Not added yet"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M18 2h-3a5 5 0 0 0-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 0 1 1-1h3z"/></svg><em class="social-tag">Not added</em></span><span class="social-item is-disabled" aria-disabled="true" title="LinkedIn — Not added yet"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-2-2 2 2 0 0 0-2 2v7h-4V8h4"/><rect x="2" y="9" width="4" height="12"/><circle cx="4" cy="4" r="2"/></svg><em class="social-tag">Not added</em></span><span class="social-item is-disabled" aria-disabled="true" title="Instagram — Not added yet"><svg viewBox="0 0 24 24" aria-hidden="true"><rect x="2" y="2" width="20" height="20" rx="5"/><path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"/><line x1="17.5" y1="6.5" x2="17.51" y2="6.5"/></svg><em class="social-tag">Not added</em></span><span class="social-item is-disabled" aria-disabled="true" title="YouTube — Not added yet"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M22.54 6.42a2.78 2.78 0 0 0-1.94-2C18.88 4 12 4 12 4s-6.88 0-8.6.46a2.78 2.78 0 0 0-1.94 2A29 29 0 0 0 1 11.75a29 29 0 0 0 .46 5.33A2.78 2.78 0 0 0 3.4 19c1.72.46 8.6.46 8.6.46s6.88 0 8.6-.46a2.78 2.78 0 0 0 1.94-2 29 29 0 0 0 .46-5.25 29 29 0 0 0-.46-5.33z"/><polygon points="9.75 15.02 15.5 11.75 9.75 8.48 9.75 15.02"/></svg><em class="social-tag">Not added</em></span></div><p class="muted small">Official account links are activated from the admin panel once approved.</p></div></div><div class="container footer-bottom"><span>© AKT Group</span><span class="footer-legal"><a href="/privacy">Privacy policy</a><a href="/terms">Terms of use</a></span><span>Illustrative architecture is not presented as AKT project photography.</span></div></footer></xpath>

    <xpath expr="//main" position="attributes">
      <attribute name="id">main</attribute>
    </xpath>

    <xpath expr="//div[@id='wrapwrap']" position="before">
      <a class="skip" href="#main">Skip to content</a>
